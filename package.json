{
  "name": "@foxelabs/docs",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation for Foxe Labs software and trading products, published to docs.foxelabs.com.",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxelabs/docs.git"
  },
  "homepage": "https://docs.foxelabs.com",
  "bugs": {
    "url": "https://github.com/foxelabs/docs/issues"
  },
  "workspaces": [
    "home",
    "software",
    "trading"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:home && npm run build:software && npm run build:trading",
    "build:home": "npm run build -w @foxelabs/docs-home && npm run copy:home",
    "build:software": "npm run build -w @foxelabs/docs-software",
    "build:trading": "npm run build -w @foxelabs/docs-trading",
    "copy:home": "mkdir -p dist && cp -R home/.vitepress/dist/. dist/",
    "dev": "npm run dev -w @foxelabs/docs-home",
    "dev:home": "npm run dev -w @foxelabs/docs-home",
    "dev:software": "npm run dev -w @foxelabs/docs-software",
    "dev:trading": "npm run dev -w @foxelabs/docs-trading",
    "preview": "npm run preview -w @foxelabs/docs-home",
    "preview:home": "npm run preview -w @foxelabs/docs-home",
    "preview:software": "npm run preview -w @foxelabs/docs-software",
    "preview:trading": "npm run preview -w @foxelabs/docs-trading",
    "clean": "rm -rf dist home/.vitepress/{cache,dist} software/.vitepress/cache trading/.vitepress/cache"
  }
}
