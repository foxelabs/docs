{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/software",
      "destination": "/software/get-started",
      "permanent": false
    },
    {
      "source": "/trading",
      "destination": "/trading/get-started",
      "permanent": false
    }
  ]
}
