{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/software",
      "destination": "/software/get-started",
      "permanent": false
    },
    {
      "source": "/trading",
      "destination": "/trading/get-started",
      "permanent": false
    },
    {
      "source": "/trading/expert-advisors/:path*",
      "destination": "/trading/:path*",
      "permanent": true
    },
    {
      "source": "/software/wp-libraries/freemius-plugin-licensing/:path*",
      "destination": "/software/wp-libraries/wp-freemius-client/:path*",
      "permanent": true
    },
    {
      "source": "/software/404-to-301",
      "destination": "https://foxelabs.com/software/plugins/404-to-301",
      "permanent": true
    },
    {
      "source": "/software/404-to-301/:path*",
      "destination": "https://foxelabs.com/software/plugins/404-to-301",
      "permanent": true
    }
  ]
}
